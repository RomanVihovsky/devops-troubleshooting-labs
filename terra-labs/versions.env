# Pinned versions (bump deliberately, then ./lab selftest all)
TERRAFORM_VERSION=1.17.1
TERRAGRUNT_VERSION=1.2.1
TFLINT_VERSION=0.65.0
MOTO_VERSION=5.2.5

# Providers mirrored into cache/providers (offline after ./lab build)
PROVIDERS="hashicorp/aws=6.72.0 hashicorp/random=3.9.1 hashicorp/null=3.3.2 hashicorp/local=2.9.1 hashicorp/time=0.14.2 hashicorp/tls=4.4.2 kreuzwerker/docker=4.6.0 hashicorp/http=3.6.3 hashicorp/external=2.4.2"

TERRAFORM_URL=https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
TERRAFORM_SUMS_URL=https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_SHA256SUMS
TERRAGRUNT_URL=https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_amd64
TERRAGRUNT_SUMS_URL=https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/SHA256SUMS
TFLINT_URL=https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}/tflint_linux_amd64.zip
TFLINT_SUMS_URL=https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}/checksums.txt

# Base images (already local on this host; never pulled at scenario time)
PY_BASE_IMAGE=python:3.12-slim
MOTO_IMAGE=terralab/moto:1
APP_IMAGES="nginx:1.27-alpine redis:7-alpine postgres:16-alpine alpine:3.20"
# Extra platforms (incident P01: lock files from a Mac) - small providers only
EXTRA_MIRROR_PLATFORM=darwin_arm64
EXTRA_MIRROR_PROVIDERS="hashicorp/random=3.9.1 hashicorp/local=2.9.1"
