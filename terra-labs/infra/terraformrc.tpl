# Generated by ./lab build - Terraform CLI config used ONLY inside the lab (TF_CLI_CONFIG_FILE).
# Your own ~/.terraformrc is never read or touched.
disable_checkpoint = true

# Providers come from the lab's offline mirror; the public registry is never contacted.
provider_installation {
  filesystem_mirror {
    path    = "@LAB_DIR@/cache/providers"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}

# Unpack each provider once (the AWS provider is ~700 MB unpacked) and symlink it into .terraform/.
plugin_cache_dir = "@LAB_DIR@/cache/plugin-cache"

# A unit without a lock entry links the cached package instead of re-installing it into the shared
# cache while parallel `terragrunt run --all` units read it (that race = "cached package ... does not
# match any of the checksums"). Lock files are still written; hashes come from the mirror.
plugin_cache_may_break_dependency_lock_file = true
