# Pinned versions (bump deliberately, then ./lab selftest all)
ANSIBLE_CORE_VERSION=2.22.0
ANSIBLE_LINT_VERSION=26.11.0
MOLECULE_VERSION=26.11.0
ANSIBLE_NAVIGATOR_VERSION=26.11.0
ANSIBLE_BUILDER_VERSION=3.2.0
YAMLLINT_VERSION=1.38.0
TESTINFRA_VERSION=10.2.2

# Collections baked into the controller (core-only install: no community "ansible" package for 2.22 yet)
COLLECTIONS="ansible.posix:2.2.2 community.general:14.0.0 community.crypto:3.5.1 community.postgresql:5.1.1"

# Images
CTL_BASE_IMAGE=python:3.13-slim
DEBIAN_BASE_IMAGE=debian:12
ROCKY_BASE_IMAGE=rockylinux/rockylinux:9
REPO_IMAGE=nginx:1.27-alpine
CTL1_IMAGE=ansiblelab/ctl:1
CTL_IMAGE=ansiblelab/ctl:2
NODE_DEBIAN_IMAGE=ansiblelab/node-debian12:1
NODE_ROCKY_IMAGE=ansiblelab/node-rocky9:1

# Internal package mirror (http://repo.acme.internal) - what the labs' roles may install
MIRROR_DEBIAN_PKGS="nginx haproxy postgresql postgresql-client python3-psycopg2 redis-server chrony rsyslog acl nftables auditd apache2 cron logrotate git rsync unzip jq openssl tar socat"
MIRROR_ROCKY_PKGS="nginx haproxy postgresql-server postgresql python3-psycopg2 redis chrony rsyslog acl nftables audit httpd cronie logrotate git rsync unzip jq openssl tar socat python3 python3-libs"
EE_BASE_IMAGE=ansiblelab/ee-base:1

# Older collection versions some scenarios pin or vendor (requirements.yml from local tarballs)
EXTRA_COLLECTIONS="community.general:12.0.0 ansible.posix:1.6.2 community.library_inventory_filtering_v1:1.1.5"

# Offline wheelhouse for Execution Environment builds (ansible-builder's builder stage + lab EE deps)
EE_WHEELS="jmespath netaddr bindep pyyaml packaging dumb-init==1.2.5"
# already in the node image, but needed in the mirror (incident I04 re-installs Python on a "minimal" node)
MIRROR_DEBIAN_EXPLICIT="python3 python3-minimal python3.11 python3.11-minimal python3-apt libpython3.11-minimal libpython3.11-stdlib libpython3-stdlib"

# Wave 2: the controller that runs is ansiblelab/ctl:2 = ctl:1 (unchanged) + infra/ctl2 (EDA, AWS, offline ansible-test).
# Python packages come from cache/pypi/<set> (pip download by ./lab build) - NOT cache/wheels, which L12/X03 copy
# wholesale into EE build contexts.
ANSIBLE_RULEBOOK_VERSION=1.3.2
JAVA_PACKAGE=openjdk-21-jre-headless
BOTO3_VERSION=1.43.126
WAVE2_COLLECTIONS="ansible.eda:2.13.0 amazon.aws:12.1.0"
MOTO_VERSION=5.2.5
MOTO_IMAGE=ansiblelab/moto:1
# ansible-test sanity's own venvs (frozen requirements of ansible-test 2.22.0 + its pip bootstrap)
SANITY_PIP_VERSION=25.2
# get-pip-25.2.py from ci-files.testing.ansible.com (ansible-test executes it) - checked by ./lab build
SANITY_GET_PIP_SHA256=b4c0f2a23c8c26893d5b9bdcd3ef8e6d3915d90f84acccafa3e7829bd0bf4414
