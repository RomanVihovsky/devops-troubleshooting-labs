# Pinned versions (bump deliberately, then re-run ./lab vm seedtest and the phase gates in PLAN.md)

# Ubuntu 24.04 cloud image, one dated release for everything:
#  - the VMDK is downloaded by the kit (k8slab.bat / k8slab.sh) on the VirtualBox host
#  - the qcow2 (same build) is cached here for ./lab vm seedtest (software-emulated boot of the seed)
UBUNTU_RELEASE=20261017
UBUNTU_VMDK_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.vmdk
UBUNTU_VMDK_SHA256=9a1e3959c9f4ad9d4752101fd4ff9a43191fb7d72e61fa20e033f9fd235ce794
UBUNTU_IMG_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
UBUNTU_IMG_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
VM_DISK_MB=40960
VM_GROUP=/k8slab
HOSTONLY_IP=192.168.56.1
HOSTONLY_NET=k8slab-net

# Seed ISO builder: pure-Python wheel, imported straight from the .whl (this desktop has no pip)
PYCDLIB_VERSION=1.22.0
PYCDLIB_URL=https://files.pythonhosted.org/packages/7c/64/5a5912a3f3ba47dba3eb7f707e51f91926b26be4bde25fe2da483f3c4a9b/pycdlib-1.22.0-py3-none-any.whl
PYCDLIB_SHA256=bfa0b3631345a14b2741fe088398b6b8dc2838442ea607fd07d027dcc67b9e94

# Desktop tools
KUBECTL_VERSION=v1.37.2

# Kubernetes 1.36/1.37 packages, containerd, CNI, addons, charts and images are pinned in Phase 1.
