# Pinned versions (bump deliberately, then re-run ./lab vm seedtest and the phase gates in PLAN.md)

# Ubuntu 24.04 cloud image, one dated release for everything:
#  - the VMDK is downloaded by the kit (k8slab.bat / k8slab.sh) on the VirtualBox host
#  - the qcow2 (same build) is cached here for ./lab vm seedtest (software-emulated boot of the seed)
UBUNTU_RELEASE=20261017
UBUNTU_VMDK_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.vmdk
UBUNTU_VMDK_SHA256=9a1e3959c9f4ad9d4752101fd4ff9a43191fb7d72e61fa20e033f9fd235ce794
UBUNTU_IMG_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
UBUNTU_IMG_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
VM_DISK_MB=40960
VM_GROUP=/k8slab
HOSTONLY_IP=192.168.56.1
HOSTONLY_NET=k8slab-net

# Seed ISO builder: pure-Python wheel, imported straight from the .whl (this desktop has no pip)
PYCDLIB_VERSION=1.22.0
PYCDLIB_URL=https://files.pythonhosted.org/packages/7c/64/5a5912a3f3ba47dba3eb7f707e51f91926b26be4bde25fe2da483f3c4a9b/pycdlib-1.22.0-py3-none-any.whl
PYCDLIB_SHA256=bfa0b3631345a14b2741fe088398b6b8dc2838442ea607fd07d027dcc67b9e94

# Desktop tools
KUBECTL_VERSION=v1.37.2

# ---- Phase 1: the cluster (rule: newest release >= 14 days old at pin time; pinned 2026-11-09)
# After changing anything here: tools/pin-artifacts.sh (-> infra/artifacts.txt), ./lab vm provision gw
K8S_BUILD_VERSION=1.36.5            # kubeadm init at this version ...
K8S_VERSION=1.37.1                  # ... then the scripted kubeadm upgrade to the baseline
CONTAINERD_VERSION=2.4.2
RUNC_VERSION=1.5.2
ETCD_TOOLS_VERSION=3.7.3            # etcdctl/etcdutl on cp1 (the cluster's etcd comes with kubeadm)
CALICO_VERSION=3.33.0               # tested against k8s 1.35-1.37
GATEWAY_API_VERSION=1.6.3
METALLB_CHART_VERSION=0.16.1
TRAEFIK_CHART_VERSION=42.1.3
METRICS_SERVER_CHART_VERSION=3.14.0
LOCAL_PATH_VERSION=0.0.37
CSI_NFS_CHART_VERSION=4.13.6
SNAPSHOTTER_VERSION=8.7.0
REGISTRY_VERSION=3.1.2              # distribution, on gw
CRANE_VERSION=0.22.1                # on gw: copies images into the registry
HELM_VERSION=4.3.1                  # desktop and gw
AGNHOST_IMAGE=registry.k8s.io/e2e-test-images/agnhost:2.66.0
BUSYBOX_IMAGE=docker.io/library/busybox:1.37

# Cluster network (host-only 192.168.56.0/24 comes from infra/vbox/nodes.csv)
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
METALLB_POOL=192.168.56.200-192.168.56.220
API_ENDPOINT=k8s-api.lab:6443        # haproxy on gw -> k8s-cp1:6443
GW_FILES=http://192.168.56.20:8080   # artifact server on gw (apt repo + files)

# ---- Phase 2: GitOps + secrets (14-day rule; pinned 2026-11-09)
ARGOCD_VERSION=3.5.6                 # CLI on the desktop; the chart below runs the same version
ARGOCD_CHART_VERSION=10.11.6
SEALED_SECRETS_VERSION=0.41.2        # kubeseal CLI; chart below runs the same controller version
SEALED_SECRETS_CHART_VERSION=2.22.0
ESO_CHART_VERSION=2.14.0             # External Secrets Operator
OPENBAO_VERSION=2.7.2                # on gw (deb; static-key auto-unseal)
GITEA_VERSION=28.2.0                 # on gw (single binary, SQLite)
SOPS_VERSION=3.13.3
AGE_VERSION=1.3.2
STERN_VERSION=1.35.0                 # multi-pod logs on the desktop (Q05)
ARGOCD_LB_IP=192.168.56.201
# Lab-owned images: registry.lab:5000/<lab path>=<upstream ref> (copied by gw sync.sh; labapp is built by ./lab images build)
LABAPP_TAGS="1.4 1.3 1.5 1.4-root 2.0.0-rc1"   # built by ./lab images build (apps/labapp/build.sh)
# lab-owned copies: <lab path>=<pinned upstream>[%<platform>] (default linux/amd64). labapp:1.6 is an arm64 image
# under an ordinary tag: on these amd64 nodes it fails with "exec format error" (P03)
LAB_IMAGES="lab/redis:7-alpine=docker.io/library/redis:7.4.11-alpine lab/postgres:16-alpine=docker.io/library/postgres:16.14-alpine
lab/nginx:1.30-alpine=docker.io/library/nginx:1.30.6-alpine lab/labapp:1.6=docker.io/library/python:3.12.16-slim%linux/arm64"
