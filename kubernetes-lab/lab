#!/usr/bin/env bash
# kubernetes-lab CLI. The cluster runs in sibling VirtualBox VMs (k8s-gw, k8s-cp1, k8s-w1..3) created
# on the physical host by the kit in infra/vbox; ./lab reaches them only over SSH. See PLAN.md.
set -euo pipefail
LAB_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
source "$LAB_DIR/lib/common.sh"
# shellcheck source=lib/vm.sh
source "$LAB_DIR/lib/vm.sh"
# shellcheck source=lib/cluster.sh
source "$LAB_DIR/lib/cluster.sh"
# shellcheck source=lib/upgrade.sh
source "$LAB_DIR/lib/upgrade.sh"
# shellcheck source=lib/golden.sh
source "$LAB_DIR/lib/golden.sh"

usage() {
  cat <<EOF
${C_BOLD}kubernetes-lab${C_0} - real kubeadm cluster in VirtualBox VMs (Phase 0: the VMs)

  ./lab vm check              this desktop VM: host-only address, SSH key, kit, shared folder
  ./lab vm kit                build the VirtualBox kit (k8slab.bat/.sh, nodes.csv, seed.iso) and
                              copy it to the shared folder - then on Windows: k8slab.bat create
  ./lab vm seedtest [node]    boot the seed under QEMU software emulation and check it (~5-10 min)
  ./lab vm wait [nodes]       wait until the VMs answer SSH with the right hostname and IP
  ./lab vm status             uptime, memory and disk of every node
  ./lab vm provision gw|nodes|all   install the gateway services / the Kubernetes node bits (idempotent)
  ./lab vm offline on|off     cut / restore the VMs' internet (NAT) - the cluster must keep working

  ./lab cluster build         kubeadm init + join + addons at the build version ($K8S_BUILD_VERSION), then doctor
  ./lab cluster upgrade <minor>   the kubeadm upgrade procedure, e.g. ./lab cluster upgrade ${K8S_VERSION%.*}
  ./lab cluster doctor        end-to-end health check (nodes, pods, pod network, DNS, LB, Ingress, storage)
  ./lab cluster golden        save the reset baseline (node files, etcd snapshot, gw configs) on this desktop
  ./lab cluster reset [cluster | node <node..>]   back to the golden, in-guest (2-3 min for cluster)
  ./lab cluster rebuild       last resort: kubeadm reset everywhere, build, upgrade, new golden (~15 min)
  eval "\$(./lab env)"         kubectl / helm for the lab cluster in this shell
  ./lab vm soak [minutes]     load every node (default 30 min) and check none stops answering
  ./lab node <node> [cmd]     shell (or a command) on a node, e.g. ./lab node cp1
  ./lab health [start|stop|N] desktop health log while the VMs work

Nodes: $(node_rows | awk '{printf "%s(%s) ", $1, $4}')
Snapshots, start/stop and deleting VMs happen on the VirtualBox host: k8slab.bat status|stop|snapshot|restore
EOF
}

case "${1:-help}" in
  vm)
    sub=${2:-check}; shift 2 || shift $#
    case $sub in
      check) vm_check ;;
      kit) vm_kit ;;
      seedtest) vm_seedtest "$@" ;;
      wait) vm_wait "$@" ;;
      status) vm_status ;;
      soak) vm_soak "$@" ;;
      provision) vm_provision "$@" ;;
      offline) vm_offline "$@" ;;
      *) die "usage: ./lab vm check|kit|seedtest|wait|status|soak|provision|offline" ;;
    esac ;;
  cluster)
    sub=${2:-doctor}; shift 2 || shift $#
    case $sub in
      build) cluster_build "$@" ;;
      upgrade) cluster_upgrade "$@" ;;
      doctor) cluster_doctor ;;
      golden) cluster_golden "$@" ;;
      reset) cluster_reset "$@" ;;
      rebuild) cluster_rebuild ;;
      *) die "usage: ./lab cluster build|upgrade|doctor|golden|reset|rebuild" ;;
    esac ;;
  env) ensure_tools; cluster_env ;;
  node)
    [ $# -ge 2 ] || die "usage: ./lab node <node> [cmd...]"
    n=$2; shift 2; ip=$(node_ip "$n"); [ -n "$ip" ] || die "unknown node: $n"
    # shellcheck disable=SC2046
    if [ $# -eq 0 ]; then exec ssh -t $(ssh_opts) "lab@$ip"; else nssh "$n" "$@"; fi ;;
  health)
    case "${2:-20}" in
      start) health_start; ok "health log: $(rel "$STATE_DIR/health.log")" ;;
      stop) health_stop ;;
      *) tail -n "${2:-20}" "$STATE_DIR/health.log" ;;
    esac ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
