#!/usr/bin/env bash
# kubernetes-lab CLI. The cluster runs in sibling VirtualBox VMs (k8s-gw, k8s-cp1, k8s-w1..3) created
# on the physical host by the kit in infra/vbox; ./lab reaches them only over SSH. See PLAN.md.
set -euo pipefail
LAB_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
source "$LAB_DIR/lib/common.sh"
# shellcheck source=lib/vm.sh
source "$LAB_DIR/lib/vm.sh"
# shellcheck source=lib/cluster.sh
source "$LAB_DIR/lib/cluster.sh"
# shellcheck source=lib/upgrade.sh
source "$LAB_DIR/lib/upgrade.sh"
# shellcheck source=lib/golden.sh
source "$LAB_DIR/lib/golden.sh"
# shellcheck source=lib/gitops.sh
source "$LAB_DIR/lib/gitops.sh"
# shellcheck source=lib/scenario.sh
source "$LAB_DIR/lib/scenario.sh"

usage() {
  cat <<EOF
${C_BOLD}kubernetes-lab${C_0} - break/fix on a real kubeadm cluster (v$K8S_VERSION) in VirtualBox VMs, GitOps + secrets

${C_BOLD}Labs${C_0}
  ./lab list [--learn|--incidents|--domain X]   labs (✔ solved, ▶ running) with level and reset scope
  ./lab start <id|random>     clean up the previous lab, broken on purpose, prints the ticket
  ./lab ticket | hint [n]     the ticket again / the next progressive hint
  ./lab verify                PASS / FAIL against the ticket's Test
  ./lab solution [-y] | solve root cause + fix (spoiler) / apply the reference fix
  ./lab diff                  your changes in workspace/<ID>/ since "as found"
  ./lab reset | stop | status start the lab again / clean up / what's running
  ./lab selftest <id..|pilots|waveN|learn|all>   start -> verify FAIL -> solve -> verify PASS
  eval "\$(./lab env)"         kubectl, helm, argocd, kubeseal, bao, sops for the lab cluster in this shell
  ./lab node <node> [cmd]     shell (or a command) on a node, e.g. ./lab node cp1

${C_BOLD}Cluster${C_0}
  ./lab cluster doctor        end-to-end health check (31 checks incl. GitOps & secrets)
  ./lab cluster reset [cluster | node <node..>]   back to the golden baseline, in-guest (~1 min)
  ./lab cluster golden        save the reset baseline (node files, etcd snapshot, gw data) on this desktop
  ./lab cluster build | upgrade <minor> | rebuild   kubeadm build at $K8S_BUILD_VERSION / upgrade / from scratch

${C_BOLD}GitOps & secrets${C_0}
  ./lab gitops gw | stack | seed | clone   OpenBao + Gitea / Sealed Secrets, ESO, Argo CD / repo / your clone
  ./lab images build          labapp image tags -> registry.lab:5000/lab/labapp
  Argo CD UI: http://$ARGOCD_LB_IP (admin, .state/argocd/admin-password)   Gitea: http://192.168.56.20:3000

${C_BOLD}VMs${C_0}
  ./lab vm check | kit | seedtest | wait | status | provision gw|nodes | offline on|off | soak [min]
  ./lab health [start|stop|N] desktop health log while the VMs work
  Snapshots, start/stop and deleting VMs happen on the VirtualBox host: k8slab.bat status|stop|snapshot|restore

Nodes: $(node_rows | awk '{printf "%s(%s) ", $1, $4}')
EOF
}

case "${1:-help}" in
  list) shift; cmd_list "$@" ;;
  start) shift; cmd_start "$@" ;;
  ticket) cmd_ticket ;;
  hint) shift; cmd_hint "$@" ;;
  verify) ensure_tools; cmd_verify ;;
  solution) shift; cmd_solution "$@" ;;
  solve) ensure_tools; cmd_solve ;;
  reset) cmd_reset ;;
  stop) ensure_tools; cmd_stop ;;
  status) cmd_status ;;
  diff) cmd_diff ;;
  selftest) shift; ensure_tools; cmd_selftest "$@" ;;
  vm)
    sub=${2:-check}; shift 2 || shift $#
    case $sub in
      check) vm_check ;;
      kit) vm_kit ;;
      seedtest) vm_seedtest "$@" ;;
      wait) vm_wait "$@" ;;
      status) vm_status ;;
      soak) vm_soak "$@" ;;
      provision) vm_provision "$@" ;;
      offline) vm_offline "$@" ;;
      *) die "usage: ./lab vm check|kit|seedtest|wait|status|soak|provision|offline" ;;
    esac ;;
  cluster)
    sub=${2:-doctor}; shift 2 || shift $#
    case $sub in
      build) cluster_build "$@" ;;
      upgrade) cluster_upgrade "$@" ;;
      doctor) cluster_doctor ;;
      golden) cluster_golden "$@" ;;
      reset) cluster_reset "$@" ;;
      rebuild) cluster_rebuild ;;
      *) die "usage: ./lab cluster build|upgrade|doctor|golden|reset|rebuild" ;;
    esac ;;
  gitops)
    sub=${2:-}; shift 2 || shift $#
    case $sub in
      gw) gitops_gw "$@" ;;
      stack) gitops_stack ;;
      seed) gitops_seed ;;
      clone) gitops_clone ;;
      *) die "usage: ./lab gitops gw|stack|seed|clone" ;;
    esac ;;
  images)
    case ${2:-} in build) images_build ;; *) die "usage: ./lab images build" ;; esac ;;
  env) gitops_tools; cluster_env ;;
  node)
    [ $# -ge 2 ] || die "usage: ./lab node <node> [cmd...]"
    n=$2; shift 2; ip=$(node_ip "$n"); [ -n "$ip" ] || die "unknown node: $n"
    # shellcheck disable=SC2046
    if [ $# -eq 0 ]; then exec ssh -t $(ssh_opts) "lab@$ip"; else nssh "$n" "$@"; fi ;;
  health)
    case "${2:-20}" in
      start) health_start; ok "health log: $(rel "$STATE_DIR/health.log")" ;;
      stop) health_stop ;;
      *) tail -n "${2:-20}" "$STATE_DIR/health.log" ;;
    esac ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
