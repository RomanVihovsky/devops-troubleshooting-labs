# Per-lab generated state: SSH keys, tfstate, progress markers. NEVER publish.
.state/
# Downloaded binaries, VM images, provider mirrors (rebuilt by ./lab build / up)
/*/cache/
# terra-labs: the student's working copy, created by ./lab start (contains its own .git)
/terra-labs/workspace/
# swarm-lab: stack files for the current scenario, created by ./lab start
/swarm-lab/workspace/
# ansible-lab: the student working copy (own .git) and CI checkout
/ansible-lab/workspace/

# Terraform / Terragrunt runtime artefacts (if a lab is run in place)
# Do NOT ignore *.tfvars or override.tf: the scenarios ship them as fixtures.
.terraform/
.terragrunt-cache/
.terragrunt-stack/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Safety net for secrets
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
.env

# Python / editors / OS
__pycache__/
*.pyc
.vscode/
.idea/
*.swp
*~
.DS_Store
